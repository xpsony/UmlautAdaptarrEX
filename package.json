{
  "name": "umlautadaptarrex",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "Umlaut/German-title proxy for Sonarr/Radarr/Lidarr/Readarr",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate && prisma migrate deploy",
    "dev": "concurrently -k -n server,ui -c green,blue \"pnpm dev:server\" \"pnpm dev:next\"",
    "dev:next": "next dev --port 5007 --hostname 127.0.0.1",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "pnpm build:next && pnpm build:server",
    "build:next": "next build",
    "build:server": "tsup",
    "build:prod": "cross-env NODE_ENV=production pnpm build",
    "start": "node start.mjs",
    "start:prod": "cross-env NODE_ENV=production node start.mjs",
    "prod": "pnpm build:prod && pnpm prisma:deploy && pnpm start:prod",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "deps:check": "pnpm outdated",
    "deps:update": "pnpm update",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "format": "prettier --write .",
    "clean": "rm -rf .next dist coverage test-results tsconfig.tsbuildinfo node_modules/.cache && find . -name .DS_Store -not -path './node_modules/*' -not -path './.git/*' -delete"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/csrf-protection": "^8.0.2",
    "@fastify/rate-limit": "^11.2.1",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.54.0",
    "moviedb-promise": "^4.0.8",
    "nanoid": "^6.0.2",
    "next": "^16.3.6",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.11.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.6",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.2"
  }
}
