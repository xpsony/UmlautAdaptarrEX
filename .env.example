# UmlautAdaptarrEX — environment template.
# Copy to `.env`. For Docker, place it next to your docker-compose file (Compose
# loads it automatically). For bare-metal / local dev, place it at the repo root.
# Uncomment and edit only what you need.

# ── Local / bare-metal dev (NOT needed for Docker: the image bakes these in) ──
# DATABASE_URL is required when running outside Docker (pnpm dev / pnpm prod).
DATABASE_URL="file:./data/umlautadaptarrex.db"
NODE_ENV="development"
# When NODE_ENV != "production" the admin session TTL is 365 days (vs 14 in
# prod), so /setup or /login lasts effectively forever during local dev.

# ── Service ports ────────────────────────────────────────────────────────────
# Defaults shown. Each var sets BOTH the in-container bind port and the
# published host port (the compose mapping uses the same value on both sides).
#
# Fastify public API + legacy indexer API (/<apiKey>/<host>/api) + WS log stream.
# This is the port your *Arr apps / Prowlarr point at.
#UMLAUTADAPTARREX_LEGACYAPI_PORT=5005
#
# Next.js Web UI (open this in your browser).
#UMLAUTADAPTARREX_WEBUI_PORT=5007
#
# TCP HTTP proxy for Prowlarr indexers. When set, this OVERRIDES the value
# stored in the database at every start, and the Settings UI shows the field
# read-only.
#UMLAUTADAPTARREX_PROXY_PORT=5006
#
# ── Headless mode (no Web UI) ────────────────────────────────────────────────
# Run without the Next.js Web UI to save memory (one fewer Node process plus no
# self-forking supervisor — roughly a third / ~50-90 MB less in this project's
# Docker tests, depending on config). ONLY works for an
# already-configured instance: start once WITHOUT this, finish the setup wizard
# in the UI, then enable it. On an unconfigured DB the container refuses to boot
# with an explanatory message. When headless you can also drop the Web UI port
# mapping (default 5007) from your compose file.
#UMLAUTADAPTARREX_HEADLESS=1

# ── Image (release compose only) ─────────────────────────────────────────────
#UMLAUTADAPTARREX_IMAGE=lexfi/umlautadaptarrex:latest

# ── Misc ─────────────────────────────────────────────────────────────────────
#TZ=Europe/Berlin
#PUID=1000
#PGID=1000
# Pino log level: trace, debug, info, warn, error, fatal. Defaults to info.
#LOG_LEVEL=info

# ── Security (only needed when fronted by an external reverse proxy) ────────
# How far to trust X-Forwarded-* headers. Default "loopback" trusts them only
# when the request arrived via 127.0.0.1/::1 (safe behind a same-host proxy).
# Set to "true" to trust any hop, an integer for a hop count, or a
# comma-separated list of trusted CIDRs/IPs when fronted by an external proxy
# (e.g. Traefik on a different host).
#TRUST_PROXY=loopback
#
# Overrides the DB-stored CSRF HMAC secret (used as a raw UTF-8 string, so it
# must be at least 32 characters/bytes long). Shorter values are ignored with
# a warning and the DB-stored secret is used instead. Only needed to pin the
# secret across restarts/instances instead of the auto-generated per-install
# one.
#CSRF_SECRET=
